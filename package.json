{
  "name": "flyto-plugins-js",
  "private": true,
  "description": "Flyto2 JavaScript and TypeScript plugin SDK for workflow automation, interactive UI steps, and human-in-the-loop AI agents.",
  "keywords": [
    "flyto2",
    "plugin-sdk",
    "workflow-automation",
    "ai-workflow-automation",
    "human-in-the-loop",
    "typescript",
    "javascript"
  ],
  "homepage": "https://flyto2.com",
  "author": "Flyto2 (https://flyto2.com)",
  "bugs": {
    "url": "https://github.com/flytohub/flyto-plugins-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flytohub/flyto-plugins-js.git"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "npm run lint && npm run test && npm run build && flyto-index verify . --json"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
