{
  "name": "@flyto2/plugin-ui-bridge",
  "version": "0.1.0",
  "description": "Communication bridge between Flyto2 plugin UIs and the host app",
  "type": "module",
  "main": "src/bridge.js",
  "types": "src/bridge.d.ts",
  "exports": {
    ".": {
      "types": "./src/bridge.d.ts",
      "default": "./src/bridge.js"
    },
    "./auto": {
      "types": "./src/auto.d.ts",
      "default": "./src/auto.js"
    }
  },
  "scripts": {
    "build": "node --check src/bridge.js && node --check src/auto.js",
    "lint": "node --check src/bridge.js && node --check src/auto.js",
    "test": "node --test src/*.test.js"
  },
  "files": [
    "src/bridge.js",
    "src/bridge.d.ts",
    "src/auto.js",
    "src/auto.d.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": ["flyto2", "plugin-ui", "plugin-bridge", "workflow-automation", "iframe"],
  "license": "Apache-2.0",
  "homepage": "https://flyto2.com",
  "bugs": { "url": "https://github.com/flytohub/flyto-plugins-js/issues" },
  "author": "Flyto2 (https://flyto2.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/flytohub/flyto-plugins-js.git",
    "directory": "packages/ui-bridge"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
