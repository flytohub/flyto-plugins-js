{
  "name": "@flyto2/plugin-sdk",
  "version": "0.1.0",
  "description": "SDK for building Flyto2 plugins in TypeScript/JavaScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/plugin.js",
    "dist/plugin.js.map",
    "dist/plugin.d.ts",
    "dist/plugin.d.ts.map",
    "dist/types.js",
    "dist/types.js.map",
    "dist/types.d.ts",
    "dist/types.d.ts.map",
    "dist/ui-server.js",
    "dist/ui-server.js.map",
    "dist/ui-server.d.ts",
    "dist/ui-server.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "flyto2",
    "plugin-sdk",
    "workflow",
    "automation",
    "workflow-automation",
